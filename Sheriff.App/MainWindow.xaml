<ui:FluentWindow x:Class="Sheriff.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:Sheriff.App" Title="Sheriff" Width="688" Height="680" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" WindowBackdropType="Mica" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable, Segoe UI" PreviewKeyDown="OnPreviewKeyDown" PreviewTextInput="OnPreviewTextInput" PreviewMouseLeftButtonUp="OnPanelMouseUp" Deactivated="OnDeactivated">
 <ui:FluentWindow.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style x:Key="TileButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="5,7"/><Setter Property="Margin" Value="2"/><Setter Property="Height" Value="88"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="IsTabStop" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#167F7F7F"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#CFB471"/><Setter TargetName="Surface" Property="Background" Value="#147F7F7F"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#287F7F7F"/></Trigger>
     <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#CFB471"/><Setter TargetName="Surface" Property="Background" Value="#147F7F7F"/></DataTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="AppTileTemplate" DataType="{x:Type local:AppTile}">
   <Grid Height="92" MouseEnter="OnTileMouseEnter" MouseLeave="OnTileMouseLeave">
    <Button x:Name="AppButton" Style="{StaticResource TileButton}" Click="OnTileClick" PreviewMouseLeftButtonDown="OnTileMouseDown" PreviewMouseMove="OnTileMouseMove" ContextMenuOpening="OnTileContextMenuOpening" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Entry.DisplayName}">
     <Button.ContextMenu><ContextMenu Closed="OnTileContextMenuClosed"/></Button.ContextMenu>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid HorizontalAlignment="Center" Width="36" Height="36"><TextBlock x:Name="FallbackIcon" Text="{Binding Initial}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="22" FontWeight="SemiBold" Opacity="0.58" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/><Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
      <TextBlock Grid.Row="1" Text="{Binding Entry.DisplayName}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="11" LineHeight="14" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="29" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
      <Ellipse Fill="#D4B46F" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0" Visibility="{Binding IsPinned, Converter={StaticResource BoolVisibility}}" ToolTip="Sabitlendi"/>
      <Border Background="#D4B46F" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="3,0" Visibility="{Binding Entry.IsNew, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Yeni" FontSize="8" FontWeight="SemiBold" Foreground="#201C13"/></Border>
     </Grid>
    </Button>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,5,0" Panel.ZIndex="2" Visibility="{Binding ShowHoverActions, Converter={StaticResource BoolVisibility}}">
     <Button Width="23" Height="20" Padding="0" Margin="0,0,2,0" Background="#E6262626" Foreground="White" BorderBrush="#66FFFFFF" BorderThickness="1" ToolTip="Taşı" AutomationProperties.Name="Uygulamayı başka kategoriye taşı" Click="OnMoveActionClick"><TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
     <Button Width="23" Height="20" Padding="0" Background="#E6262626" Foreground="White" BorderBrush="#66FFFFFF" BorderThickness="1" ToolTip="Kategoriden kaldır" AutomationProperties.Name="Uygulamayı kategoriden kaldır" Click="OnRemoveActionClick"><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
    </StackPanel>
   </Grid>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="CategoryPreviewTemplate" DataType="{x:Type local:AppTile}">
   <Grid Width="56" Height="56" Margin="1" MouseEnter="OnTileMouseEnter" MouseLeave="OnTileMouseLeave">
    <Button Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" BorderThickness="0" Padding="0" Click="OnTileClick" ContextMenuOpening="OnTileContextMenuOpening" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Entry.DisplayName}">
     <Button.ContextMenu><ContextMenu Closed="OnTileContextMenuClosed"/></Button.ContextMenu>
     <Grid><TextBlock x:Name="PreviewFallbackIcon" Text="{Binding Initial}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="21" FontWeight="SemiBold" Opacity="0.58" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/><Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Fill="#D4B46F" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,4,0" Visibility="{Binding IsPinned, Converter={StaticResource BoolVisibility}}"/></Grid>
    </Button>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="2" Visibility="{Binding ShowHoverActions, Converter={StaticResource BoolVisibility}}">
     <Button Width="17" Height="17" Padding="0" Margin="0,0,1,0" Background="#E6262626" Foreground="White" BorderBrush="#66FFFFFF" BorderThickness="1" ToolTip="Taşı" AutomationProperties.Name="Uygulamayı başka kategoriye taşı" Click="OnMoveActionClick"><TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
     <Button Width="17" Height="17" Padding="0" Background="#E6262626" Foreground="White" BorderBrush="#66FFFFFF" BorderThickness="1" ToolTip="Kategoriden kaldır" AutomationProperties.Name="Uygulamayı kategoriden kaldır" Click="OnRemoveActionClick"><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
    </StackPanel>
   </Grid>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="PreviewFallbackIcon" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="CategoryCardTemplate" DataType="{x:Type local:CatalogCategoryCard}">
   <Grid Height="180" Margin="3,3,3,6" Focusable="True" KeyboardNavigation.IsTabStop="True" Cursor="Hand" AllowDrop="True" DragOver="OnCategoryDragOver" DragLeave="OnCategoryDragLeave" Drop="OnCategoryDrop" MouseLeftButtonUp="OnCategoryCardClick" KeyDown="OnCategoryCardKeyDown" AutomationProperties.Name="{Binding AccessibleName}" ToolTip="Kategoriyi aç veya uygulama sürükleyin">
    <Grid.RowDefinitions><RowDefinition Height="148"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Width="144" Height="144" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#247F7F7F" BorderBrush="#357F7F7F" BorderThickness="1" CornerRadius="11">
     <Grid>
      <ItemsControl ItemsSource="{Binding PreviewTiles}" ItemTemplate="{StaticResource CategoryPreviewTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="30" Opacity="0.18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding HasNoPreviewTiles, Converter={StaticResource BoolVisibility}}"/>
     </Grid>
    </Border>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
     <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" MaxWidth="132" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     <TextBlock Text="{Binding Count}" FontSize="10" Opacity="0.5" Margin="5,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:CatalogCategoryRow}">
   <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CategoryCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:CatalogHeader}">
   <Button Click="OnCategoryClick" AllowDrop="True" DragOver="OnCategoryDragOver" DragLeave="OnCategoryDragLeave" Drop="OnCategoryDrop" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" BorderThickness="0" Padding="6,12,6,5" HorizontalContentAlignment="Stretch" IsTabStop="False" ToolTip="Bu kategoriye uygulama sürükleyin" AutomationProperties.Name="{Binding AccessibleName}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.45" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBlock Grid.Column="3" Text="{Binding Chevron}" FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Opacity="0.55" Margin="12,0,4,0"/></Grid></Button>
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:CatalogTileRow}"><Border AllowDrop="True" DragOver="OnCategoryDragOver" DragLeave="OnCategoryDragLeave" Drop="OnCategoryDrop" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8"><ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource AppTileTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></Border></DataTemplate>
 </ui:FluentWindow.Resources>
 <Border Padding="22,20,22,16" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="12">
  <Grid x:Name="PanelContent" RenderTransformOrigin="0.5,0.5">
   <Grid.RenderTransform><TranslateTransform x:Name="ContentOffset"/></Grid.RenderTransform>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="6,0,3,19"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Viewbox Width="23" Height="23" Margin="0,0,10,0"><Grid Width="30" Height="30"><Path Fill="#D4B46F" Data="M15,1 L19,8 L27,8 L23,15 L27,22 L19,22 L15,29 L11,22 L3,22 L7,15 L3,8 L11,8 Z"/><Ellipse Width="8" Height="8" Stroke="#514126" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Viewbox>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Sheriff" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Tümü" FontSize="11" Opacity="0.45" Margin="12,5,0,0"/></StackPanel>
    <Button Grid.Column="2" Click="OnSettingsClick" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" Opacity="0.75"/></Button>
   </Grid>
   <Grid Grid.Row="1" Margin="4,0,4,15"><TextBox x:Name="SearchBox" Height="44" FontSize="14" Padding="38,10,40,10" TextChanged="OnSearchChanged" AutomationProperties.Name="Uygulama ara" ToolTip="Uygulama veya yayıncı ara"/><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0.55"/><TextBlock x:Name="SearchPlaceholder" Text="Uygulamalarınızda arayın" FontSize="14" Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.45"/><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="0.35"/></Grid>
   <StackPanel x:Name="FrequentSection" Grid.Row="2" Margin="0,0,0,8"><TextBlock Text="Sık kullanılanlar" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,7" Opacity="0.65"/><ItemsControl x:Name="FrequentItems" ItemTemplate="{StaticResource AppTileTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><Border Height="1" Background="#167F7F7F" Margin="6,12,6,0"/></StackPanel>
   <Grid x:Name="CategoryNavigation" Grid.Row="2" Margin="3,0,3,8" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Click="OnBackToCategories" Height="32" Padding="8,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.Name="Tüm kategorilere dön"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="Tümü" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button><TextBlock x:Name="CategoryTitle" Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7"/></Grid>
   <Grid Grid.Row="3"><ListBox x:Name="TileList" PreviewDragOver="OnListDragOver" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0.5" AutomationProperties.Name="Uygulama kategorileri"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox>
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="30" HorizontalAlignment="Center" Opacity="0.35"/><TextBlock x:Name="EmptyTitle" Text="Henüz uygulama yok" FontSize="18" Margin="0,15,0,7" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="Uygulamalarınız arka planda hazırlanıyor." FontSize="12" Opacity="0.5" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
   </Grid>
   <Grid Grid.Row="4" Margin="6,14,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Sheriff hazır" FontSize="10.5" Opacity="0.45" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="↑ ↓  gezin    Enter  aç    Esc  kapat" FontSize="10.5" Opacity="0.4" Margin="12,0,0,0"/></Grid>
  </Grid>
 </Border>
</ui:FluentWindow>
