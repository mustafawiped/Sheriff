<ui:FluentWindow x:Class="Sheriff.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:Sheriff.App" Title="Sheriff" Width="{x:Static local:InterfaceMetrics.MainWidth}" Height="{x:Static local:InterfaceMetrics.MainHeight}" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" WindowBackdropType="Mica" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable, Segoe UI" PreviewKeyDown="OnPreviewKeyDown" PreviewTextInput="OnPreviewTextInput" PreviewMouseLeftButtonUp="OnPanelMouseUp" Deactivated="OnDeactivated">
 <ui:FluentWindow.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style x:Key="TileButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="5,7"/><Setter Property="Margin" Value="2"/><Setter Property="Height" Value="88"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="IsTabStop" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#167F7F7F"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#CFB471"/><Setter TargetName="Surface" Property="Background" Value="#147F7F7F"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#287F7F7F"/></Trigger>
     <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#CFB471"/><Setter TargetName="Surface" Property="Background" Value="#147F7F7F"/></DataTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PreviewSlotButton" TargetType="Button">
   <Setter Property="Width" Value="72"/><Setter Property="Height" Value="72"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="PreviewSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PreviewSurface" Property="Background" Value="#127F7F7F"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="PreviewSurface" Property="Background" Value="#247F7F7F"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PreviewSurface" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="AppTileTemplate" DataType="{x:Type local:AppTile}">
   <Grid Height="92" MouseEnter="OnTileMouseEnter" MouseLeave="OnTileMouseLeave">
    <Button x:Name="AppButton" Style="{StaticResource TileButton}" Click="OnTileClick" PreviewMouseLeftButtonDown="OnTileMouseDown" PreviewMouseMove="OnTileMouseMove" ContextMenuOpening="OnTileContextMenuOpening" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Entry.DisplayName}">
     <Button.ContextMenu><ContextMenu Closed="OnTileContextMenuClosed"/></Button.ContextMenu>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid HorizontalAlignment="Center" Width="36" Height="36"><TextBlock x:Name="FallbackIcon" Text="{Binding Initial}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="22" FontWeight="SemiBold" Opacity="0.58" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/><Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
      <TextBlock Grid.Row="1" Text="{Binding Entry.DisplayName}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="11" LineHeight="14" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="29" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
      <Ellipse Fill="#D4B46F" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0" Visibility="{Binding IsPinned, Converter={StaticResource BoolVisibility}}" ToolTip="Sabitlendi"/>
      <Border Background="#D4B46F" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="3,0" Visibility="{Binding Entry.IsNew, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Yeni" FontSize="8" FontWeight="SemiBold" Foreground="#201C13"/></Border>
     </Grid>
    </Button>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,5,0" Panel.ZIndex="2" Visibility="{Binding ShowHoverActions, Converter={StaticResource BoolVisibility}}">
     <Button Width="23" Height="20" Padding="0" Margin="0,0,2,0" Background="#E6262626" Foreground="White" BorderBrush="#66FFFFFF" BorderThickness="1" ToolTip="Taşı" AutomationProperties.Name="Uygulamayı başka kategoriye taşı" Click="OnMoveActionClick"><TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
     <Button Width="23" Height="20" Padding="0" Background="#E6262626" Foreground="White" BorderBrush="#66FFFFFF" BorderThickness="1" ToolTip="Kategoriden kaldır" AutomationProperties.Name="Uygulamayı kategoriden kaldır" Click="OnRemoveActionClick"><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
    </StackPanel>
   </Grid>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="CategoryPreviewTemplate" DataType="{x:Type local:AppTile}">
   <Grid Width="72" Height="72" MouseEnter="OnTileMouseEnter" MouseLeave="OnTileMouseLeave">
    <Button Style="{StaticResource PreviewSlotButton}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Click="OnTileClick" PreviewMouseLeftButtonDown="OnTileMouseDown" PreviewMouseMove="OnTileMouseMove" ContextMenuOpening="OnTileContextMenuOpening" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Entry.DisplayName}">
     <Button.ContextMenu><ContextMenu Closed="OnTileContextMenuClosed"/></Button.ContextMenu>
     <Grid Width="40" Height="40"><TextBlock x:Name="PreviewFallbackIcon" Text="{Binding Initial}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="27" FontWeight="SemiBold" Opacity="0.58" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/><Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Fill="#D4B46F" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Visibility="{Binding IsPinned, Converter={StaticResource BoolVisibility}}"/></Grid>
    </Button>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="2" Visibility="{Binding ShowHoverActions, Converter={StaticResource BoolVisibility}}">
     <Button Width="17" Height="17" Padding="0" Margin="0,0,1,0" Background="#E6262626" Foreground="White" BorderBrush="#66FFFFFF" BorderThickness="1" ToolTip="Taşı" AutomationProperties.Name="Uygulamayı başka kategoriye taşı" Click="OnMoveActionClick"><TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
     <Button Width="17" Height="17" Padding="0" Background="#E6262626" Foreground="White" BorderBrush="#66FFFFFF" BorderThickness="1" ToolTip="Kategoriden kaldır" AutomationProperties.Name="Uygulamayı kategoriden kaldır" Click="OnRemoveActionClick"><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
    </StackPanel>
   </Grid>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="PreviewFallbackIcon" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="MiniPreviewTemplate" DataType="{x:Type local:AppTile}">
   <Grid Width="22" Height="22" IsHitTestVisible="False"><TextBlock x:Name="MiniFallbackIcon" Text="{Binding Initial}" FontSize="13" FontWeight="SemiBold" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/><Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="MiniFallbackIcon" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="CategoryCardTemplate" DataType="{x:Type local:CatalogCategoryCard}">
   <Grid x:Name="CardRoot" Width="194" Height="255" Margin="0,0,30,0" Background="Transparent" Focusable="True" KeyboardNavigation.IsTabStop="True" Cursor="Hand" AllowDrop="True" DragOver="OnCategoryDragOver" DragLeave="OnCategoryDragLeave" Drop="OnCategoryDrop" PreviewMouseLeftButtonDown="OnCategoryCardClick" MouseEnter="OnCategoryCardMouseEnter" MouseLeave="OnCategoryCardMouseLeave" KeyDown="OnCategoryCardKeyDown" AutomationProperties.Name="{Binding AccessibleName}" ToolTip="Kategoriyi aç veya uygulama sürükleyin">
    <Grid.RowDefinitions><RowDefinition Height="194"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="CardSurface" Width="194" Height="194" Padding="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{Binding SurfaceBrush}" BorderBrush="{Binding OutlineBrush}" BorderThickness="1" CornerRadius="12">
     <Grid>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ItemsControl Grid.RowSpan="2" Grid.ColumnSpan="2" ItemsSource="{Binding PrimaryPreviewTiles}" ItemTemplate="{StaticResource CategoryPreviewTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" Rows="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource PreviewSlotButton}" Click="OnOverflowPreviewClick" AutomationProperties.Name="{Binding OverflowAccessibleName}" ToolTip="{Binding OverflowAccessibleName}" Visibility="{Binding HasOverflowPreviewTiles, Converter={StaticResource BoolVisibility}}"><ItemsControl Width="44" Height="44" ItemsSource="{Binding OverflowPreviewTiles}" ItemTemplate="{StaticResource MiniPreviewTemplate}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" Rows="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></Button>
      <TextBlock Grid.RowSpan="2" Grid.ColumnSpan="2" Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="32" Opacity="0.18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding HasNoPreviewTiles, Converter={StaticResource BoolVisibility}}"/>
     </Grid>
    </Border>
    <TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontSize="16" FontWeight="Normal" Width="194" Height="23" Margin="0,14,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" VerticalAlignment="Top"/>
   </Grid>
   <DataTemplate.Triggers><Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="#66FFFFFF"/></Trigger><Trigger SourceName="CardRoot" Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/></Trigger></DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:CatalogCategoryRow}">
   <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CategoryCardTemplate}" HorizontalAlignment="Left"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:CatalogTileRow}"><Border AllowDrop="True" DragOver="OnCategoryDragOver" DragLeave="OnCategoryDragLeave" Drop="OnCategoryDrop" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8"><ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource AppTileTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></Border></DataTemplate>
 </ui:FluentWindow.Resources>
 <Border LayoutTransform="{x:Static local:InterfaceMetrics.ContentScale}" Padding="30,20,30,16" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="12">
  <Grid x:Name="PanelContent" RenderTransformOrigin="0.5,0.5">
   <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="ContentScale"/><TranslateTransform x:Name="ContentOffset"/></TransformGroup></Grid.RenderTransform>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="6,0,3,19"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Viewbox Width="23" Height="23" Margin="0,0,10,0"><Grid Width="30" Height="30"><Path Fill="#D4B46F" Data="M15,1 L19,8 L27,8 L23,15 L27,22 L19,22 L15,29 L11,22 L3,22 L7,15 L3,8 L11,8 Z"/><Ellipse Width="8" Height="8" Stroke="#514126" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Viewbox>
    <TextBlock Grid.Column="1" Text="Sheriff" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button Grid.Column="2" Click="OnSettingsClick" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" Opacity="0.75"/></Button>
   </Grid>
   <Grid Grid.Row="1" Margin="4,0,4,15"><TextBox x:Name="SearchBox" Height="44" FontSize="14" Padding="38,10,40,10" TextChanged="OnSearchChanged" AutomationProperties.Name="Uygulama ara" ToolTip="Uygulama veya yayıncı ara"/><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0.55"/><TextBlock x:Name="SearchPlaceholder" Text="Uygulamalarınızda arayın" FontSize="14" Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.45"/><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="0.35"/></Grid>
   <StackPanel x:Name="FrequentSection" Visibility="Collapsed" Grid.Row="2" Margin="0,0,0,8"><TextBlock Text="Sık kullanılanlar" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,7" Opacity="0.65"/><ItemsControl x:Name="FrequentItems" ItemTemplate="{StaticResource AppTileTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><Border Height="1" Background="#167F7F7F" Margin="6,12,6,0"/></StackPanel>
   <Grid x:Name="CategorySectionHeading" Grid.Row="2" Margin="0,0,0,16" Height="20"><TextBlock Text="Tümü" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="Görünüm: Kategori" FontSize="16"/><TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid><Grid Grid.Row="3"><ListBox x:Name="TileList" Margin="0,0,-16,0" PreviewDragOver="OnListDragOver" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0.5" AutomationProperties.Name="Uygulama kategorileri"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox>
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="30" HorizontalAlignment="Center" Opacity="0.35"/><TextBlock x:Name="EmptyTitle" Text="Henüz uygulama yok" FontSize="18" Margin="0,15,0,7" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="Kurulu uygulamalar ilk tarama tamamlanınca burada görünecek." FontSize="12" Opacity="0.5" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
   </Grid>
   <Grid Grid.Row="4" Margin="6,14,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Sheriff hazır" FontSize="10.5" Opacity="0.45" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="↑ ↓  gezin    Enter  aç    Esc  kapat" FontSize="10.5" Opacity="0.4" Margin="12,0,0,0"/></Grid>
  </Grid>
 </Border>
</ui:FluentWindow>
